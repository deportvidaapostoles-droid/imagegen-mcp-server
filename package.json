{
  "name": "@ayaka209/assets-gen-mcp",
  "version": "0.1.0",
  "description": "MCP server for image generation, supports OpenAI DALL-E and Google Gemini",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "assets-gen-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "models": "npx tsx src/list-models.ts",
    "test": "vitest run --exclude src/integration.test.ts",
    "test:watch": "vitest --exclude src/integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude src/integration.test.ts",
    "test:integration": "vitest run src/integration.test.ts"
  },
  "keywords": [
    "mcp",
    "image-generation",
    "openai",
    "gemini",
    "dalle"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "openai": "^4.77.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.3",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
