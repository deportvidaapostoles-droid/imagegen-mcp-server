{
  "name": "imagegen-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for AI image generation and editing, supports OpenAI and Google Gemini",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "imagegen-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "models": "npx tsx src/list-models.ts",
    "models:openai": "npx tsx src/list-openai-models.ts",
    "test:openai-proxy": "npx tsx src/test-openai-proxy.ts",
    "test": "vitest run --exclude src/integration.test.ts",
    "test:watch": "vitest --exclude src/integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude src/integration.test.ts",
    "test:integration": "vitest run src/integration.test.ts"
  },
  "keywords": [
    "mcp",
    "image-generation",
    "openai",
    "gemini",
    "dalle"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/ptbsare/imagegen-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ptbsare/imagegen-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptbsare/imagegen-mcp-server.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^17.2.3",
    "openai": "^4.77.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
