# ─── ImageGen MCP Server — environment variables ────────────────────────────
# Copy to `.env` for local development. On Vercel, set these under
# Project Settings → Environment Variables (never commit real keys).

# Provider: openai | gemini  (default: openai)
IMAGEGEN_PROVIDER=openai

# Model name (default: gpt-image-1)
#   openai: gpt-image-1 | dall-e-3 | dall-e-2 | any OpenAI-compatible image model
#   gemini: gemini-2.5-flash-image | imagen-*
IMAGEGEN_MODEL=gpt-image-1

# ─── Provider credentials (set the ones matching IMAGEGEN_PROVIDER) ─────────
# Required when IMAGEGEN_PROVIDER=openai
OPENAI_API_KEY=
# Optional: OpenAI-compatible proxy / gateway base URL
OPENAI_BASE_URL=

# Required when IMAGEGEN_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: Gemini API base URL
GEMINI_BASE_URL=

# ─── Behaviour ──────────────────────────────────────────────────────────────
# Default tool timeout in seconds (default: 300).
# On Vercel this must stay below the function maxDuration in vercel.json.
IMAGEGEN_TIMEOUT=55

# Expose only the async task tools (submit_task / get_task). Default: false.
# Not recommended for serverless: the task store is per-instance memory.
IMAGEGEN_ASYNC_ONLY=false

# Make get_task block until the task finishes (default: false)
IMAGEGEN_BLOCKING_POLL=false
# Blocking poll timeout in seconds (default: 120)
IMAGEGEN_BLOCKING_POLL_TIMEOUT=120
# Retries per async task (default: 3)
IMAGEGEN_MAX_RETRIES=3
# Async task upstream timeout in seconds (default: 600)
IMAGEGEN_TASK_TIMEOUT=600

# ─── Authentication (remote HTTP deployments) ───────────────────────────────
# 'none' (default) leaves the endpoint open — only acceptable for stdio or a
# private local server. Set to 'oauth' on any public deployment.
MCP_AUTH_MODE=none

# Issuer URL of your identity provider (Auth0, WorkOS, Okta, Entra ID, …).
# Required when MCP_AUTH_MODE=oauth. Example: https://your-tenant.us.auth0.com
MCP_OAUTH_ISSUER=

# Resource identifier this server accepts tokens for (RFC 8707). It must match
# the API identifier configured at the provider, and is normally the public MCP
# URL. Required when MCP_AUTH_MODE=oauth.
MCP_OAUTH_AUDIENCE=https://<your-project>.vercel.app/mcp

# Optional: skip discovery and point straight at the provider's JWKS.
MCP_OAUTH_JWKS_URI=

# ─── Who may use the server ────────────────────────────────────────────────
# Comma-separated list of the people allowed in. Anyone who authenticates with
# the provider but is not listed here gets a 403.
MCP_ALLOWED_EMAILS=

# Optional: allow every verified address of a corporate domain.
MCP_ALLOWED_EMAIL_DOMAINS=

# Optional: allow by provider user id, for tokens without an email claim.
MCP_ALLOWED_SUBJECTS=

# Optional: claim carrying the email in the access token (default: email).
# Auth0 Actions usually namespace it, e.g. https://imagegen/email
MCP_EMAIL_CLAIM=

# Optional: scopes the access token must carry, e.g. mcp:use
MCP_REQUIRED_SCOPES=

# Optional: canonical public URL, when the deployment sits behind a proxy that
# rewrites Host. Used to build the OAuth metadata URLs.
MCP_PUBLIC_URL=

# ─── Local transport (ignored on Vercel: the function is always HTTP) ───────
# stdio | http | sse   (default: stdio)
MCP_TRANSPORT=stdio
# Enable stderr logs while running on stdio
MCP_STDIO_LOGS=false
# Bind address for `http` / `sse` mode
MCP_HOST=localhost
MCP_PORT=3000
